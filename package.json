{
  "name": "calcweave",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "CalcWeave: bounded mathematical diagrams, simulation and executable code export",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build-policies.ts && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify:coverage": "tsx scripts/verify-coverage.ts",
    "verify:design": "tsx scripts/verify-design.ts",
    "verify:design:m4": "tsx scripts/verify-design.ts --m4",
    "verify:m1": "tsx scripts/verify-m1.ts",
    "verify:m2": "tsx scripts/verify-m2.ts",
    "verify:m3": "tsx scripts/verify-m3.ts",
    "verify:m4": "tsx scripts/verify-m4.ts",
    "verify:m5": "tsx scripts/verify-m5.ts",
    "verify:design:m5": "tsx scripts/verify-design.ts --m5",
    "verify:design:m6": "tsx scripts/verify-design.ts --m6",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:performance:m6": "tsx scripts/verify-performance-m6.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "verify:m7": "tsx scripts/verify-m7.ts",
    "verify:design:m7": "tsx scripts/verify-design.ts --m7",
    "verify:performance:m7": "tsx scripts/verify-performance-m6.ts",
    "verify:catalog": "tsx scripts/verify-catalog.ts",
    "verify:design:catalog": "tsx scripts/verify-design.ts --catalog",
    "verify:performance:catalog": "tsx scripts/verify-performance-m6.ts",
    "verify:roadmap": "tsx scripts/verify-roadmap.ts",
    "test:e2e:pages": "playwright test --config=playwright.pages.config.ts",
    "verify:pages:browser": "tsx scripts/verify-public-pages.ts",
    "verify:m8": "tsx scripts/verify-m8.ts",
    "verify:m9": "tsx scripts/verify-m9.ts",
    "verify:m10": "tsx scripts/verify-m10.ts",
    "verify:m11": "tsx scripts/verify-m11.ts",
    "verify:m12": "tsx scripts/verify-m12.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
