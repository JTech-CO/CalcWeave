        "14-003"
      ],
      "referenceId": "datatypeconversion",
      "decision": "RWV preserves interpreted values; SI preserves fixed stored integers. SI does not reinterpret floating IEEE bits. Selected nearest/away/even ties are +infinity/away-from-zero/even; float bit extraction is a separate primitive.",
      "remaining": "slope-bias, half, inherited back-propagation combinations and enum numerical casts remain open"
    },
    {
      "sourceIds": [
        "06-001",
        "06-002",
        "06-015",
        "06-016",
        "06-022"
      ],
      "referenceIds": [
        "bitclear",
        "bitset",
        "extractbits",
        "floatextractbits",
        "shiftarithmetic"
      ],
      "decision": "Index0 is LSB; fixed scaling is ignored by stored-bit selection. IEEE fields use the stored float format. Arithmetic bit shifts and binary-point shifts have distinct effects; bidirectional positive shift means right.",
      "remaining": "all source hardware/diagnostic/special-payload combinations remain open",
      "selectedBinaryPointMeaning": "Positive shift moves binary point right: fractionLength decreases and unchanged SI has larger real value."
    },
    {
      "sourceIds": [
        "07-003",
        "07-008"
      ],
      "referenceId": "sine",
      "decision": "Source uses a turn-phase fixed quarter-wave table. The selected interpolated stored-code realization is an independent alternative because Speed/Precision internal rules and reference bits are unverified.",
      "declaredAlgorithm": {
        "wordLength": [
          2,
          53
        ],
        "fractionLength": "wordLength-2",
        "tablePoints": "2..min(1024,2^(wordLength-2)+1)",
        "phase": "normalized periodic turn; cosine shifts phase by1/4",
        "table": "j=0..N-1 quarter-wave sine values quantized into stored codes",
        "interpolation": "reflect/sign by quadrant, linear interpolation of stored codes, selected rounding and wrap"
      },
      "literalBitOracles": [
